# TubePlay Server - Variables de Entorno
# Copia este archivo a .env y completa los valores

PORT=5000
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/tubeplay
JWT_SECRET=genera_una_clave_segura_aleatoria_aqui
YOUTUBE_API_KEY=tu_api_key_de_youtube

# Para produccion: dominios permitidos por CORS (separados por coma)
CORS_ORIGIN=https://tubeplay.vercel.app,https://tubeplay.netlify.app
